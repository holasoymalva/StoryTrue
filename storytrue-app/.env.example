# ClaudeCode API Configuration
VITE_CLAUDE_API_KEY=your_claude_api_key_here
VITE_CLAUDE_API_URL=https://api.claude.ai/v1

# Firebase Configuration (if using Firebase for real-time features)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# WebSocket Configuration (alternative to Firebase)
VITE_WEBSOCKET_URL=ws://localhost:3001

# Deployment Configuration
VITE_BASE_URL=/storytrue-multiplayer-trivia/
VITE_GITHUB_PAGES=true